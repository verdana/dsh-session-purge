{
  "name": "dsh-session-purge",
  "version": "0.4.1",
  "description": "Adds a \"删除会话 / Delete session\" item to the session-row context menu (next to rename/fork/archive) — permanently removes session logs from disk, with live-session protection and a restart fallback queue.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/verdana/dsh-session-purge.git"
  },
  "homepage": "https://github.com/verdana/dsh-session-purge#readme",
  "bugs": {
    "url": "https://github.com/verdana/dsh-session-purge/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "lib",
    "client",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test tools/*.test.mjs",
    "release:check": "node scripts/publish-npm.mjs",
    "release": "node scripts/publish-npm.mjs --publish",
    "smoke": "node tools/smoke-install.mjs"
  },
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "session",
    "delete",
    "purge"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  }
}
